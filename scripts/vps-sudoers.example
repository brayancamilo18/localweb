# /etc/sudoers.d/onez-github-deploy
# Sustituye DEPLOY_USER por secrets.VPS_USER de GitHub.
#
# Crear con: sudo visudo -f /etc/sudoers.d/onez-github-deploy
# Validar:   sudo visudo -c

DEPLOY_USER ALL=(ALL) NOPASSWD: /usr/bin/bash /var/www/onez/deploy.sh
DEPLOY_USER ALL=(ALL) NOPASSWD: /var/www/onez/deploy.sh

# Si sudo-rs sigue bloqueando, solo para el usuario de CI (no uses en cuentas humanas):
# DEPLOY_USER ALL=(ALL) NOPASSWD: ALL

# Alternativa: en GitHub Secrets pon VPS_USER=root y el workflow detecta id -u 0
# y ejecuta deploy.sh sin sudo externo (deploy.sh ya usa sudo -u www-data por dentro).
