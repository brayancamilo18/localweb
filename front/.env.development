# Misma origen que Vite → el proxy reenvía /api a :8000 y evita CORS en el navegador
VITE_API_URL=/api/v1

# Local: subdominios de vista previa (silgodev.localweb.es). En app.onez.es se usa onez.es automáticamente.
# VITE_PUBLIC_PAGE_HOST=localweb.es

# Opcional: enlaces por defecto del pie para vista previa / plan gratis (URLs públicas de LocalWeb)
# VITE_DEFAULT_INSTAGRAM_URL=https://www.instagram.com/localweb.es
# VITE_DEFAULT_TIKTOK_URL=https://www.tiktok.com/@localweb
# VITE_DEFAULT_FACEBOOK_URL=https://www.facebook.com/localweb
