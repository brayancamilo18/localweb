APP_NAME=ONEZ
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# SPA: orígenes permitidos para CORS (coma-separados). Por defecto incluye localhost, 5173/4173 y patrones *.localhost.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Patrones regex adicionales (coma-separados). Si no se define, se usan *.localhost y el APP_DOMAIN de producción.
# CORS_ALLOWED_ORIGINS_PATTERNS=#^https://[\w-]+\.onez\.es$#

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# En producción: warning o error. info/debug filtran datos de subida útiles solo en desarrollo.
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# SPA auth (Sanctum cookie mode):
# - SESSION_DRIVER=redis o database. En docker-compose usamos redis.
# - SESSION_DOMAIN: en dev "localhost"; en prod ".onez.es" para compartir entre
#   subdominios (app.onez.es y api.onez.es). La cookie sigue siendo localweb_session
#   mientras APP_NAME no se renombre en un deploy coordinado (ver config/session.php).
# - SESSION_SAME_SITE=lax permite navegación cross-subdomain pero bloquea POST cross-site.
# - SESSION_SECURE_COOKIE=true SOLO en producción (HTTPS); en dev sobre http debe ser false.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_DRIVER=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Dominios cuyos requests reciben cookies de sesión (Sanctum SPA).
# Dev: localhost en Vite (5173 dev, 4173 preview) y 127.0.0.1.
# Prod: ej. "app.onez.es,onez.es".
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:4173,127.0.0.1:5173,127.0.0.1:4173

# ─── Correo: SMTP de Hostinger (puerto 465 + SSL) ───
# El buzón debe estar creado en hPanel. `MAIL_USERNAME` y `MAIL_FROM_ADDRESS`
# deben coincidir EXACTAMENTE con la dirección del buzón o Hostinger rechaza el envío.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="ONEZ"

# ─── Producción (descomenta y rellena con tu proveedor: Mailgun / Postmark / Resend) ───
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=mg.tu-dominio.com
# MAILGUN_SECRET=
# MAILGUN_ENDPOINT=api.eu.mailgun.net   # o api.mailgun.net (US)
# MAIL_FROM_ADDRESS="no-reply@tu-dominio.com"
#
# MAIL_MAILER=postmark
# POSTMARK_TOKEN=
#
# MAIL_MAILER=resend
# RESEND_KEY=

# ─── MinIO (S3 compatible): servicios `minio` + `minio-init` en docker-compose.yml ───
# Consola: http://localhost:9001 · API S3: http://localhost:9000 · Usuario/contraseña: localweb / localweb-secret-minio
# (credenciales y bucket MinIO «localweb»: no renombrar en prod; ver rebrand-inventory.md)
# Laravel en contenedor: AWS_ENDPOINT=http://minio:9000 · Navegador (URLs de fotos): AWS_URL con localhost:9000
# Sin MinIO: FILESYSTEM_DISK=local y borra AWS_ACCESS_KEY_ID para usar disco local r2-local.
FILESYSTEM_DISK=r2
AWS_ACCESS_KEY_ID=localweb
AWS_SECRET_ACCESS_KEY=localweb-secret-minio
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=localweb
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://localhost:9000/localweb

# Si antes las fotos se guardaron en disco local (sin AWS_*), MinIO dará 404 hasta migrar:
# docker compose exec php php artisan business-images:sync-to-object-storage

# Stripe (onboarding plan Pro / último paso)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Precio mensual Pro en Stripe (crear en Dashboard o: php artisan stripe:sync-pro-price)
# Debe ser 8,99 €/mes → unit_amount 899, currency eur (ver comando artisan).
STRIPE_PRO_PRICE_ID=
STRIPE_COUPON_REF_FIRST_FREE=
STRIPE_COUPON_REFERRER_REWARD=
REFERRAL_REWARD_THRESHOLD=1
REFERRAL_MAX_PER_USER=5
REFERRAL_TEMPLATE_GIFT_AT=5
REFERRAL_ADMIN_NOTIFY_EMAIL=contacto@onez.es
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=es_ES
FRONTEND_URL=http://localhost:5173

# Dominio de páginas públicas ({subdominio}.{domain}). En prod con FRONTEND_URL=https://app.onez.es
# se infiere onez.es; opcional forzar: PUBLIC_PAGE_DOMAIN=onez.es
# PUBLIC_PAGE_DOMAIN=onez.es
# PUBLIC_PAGE_SCHEME=https

# Analytics / RGPD: salt secreto para HMAC de IPs en page_visits (obligatorio en producción).
# Generar: php -r "echo bin2hex(random_bytes(32));"
# Sin valor: no se persiste ip_hash (se registra un warning); los tests definen su propio salt.
ANALYTICS_IP_SALT=

# Webhook local: en terminal, `stripe login` y luego reenvío al Laravel que reciba /stripe/webhook
# · Docker (nginx en puerto 80): stripe listen --forward-to http://127.0.0.1/stripe/webhook
# · php artisan serve (8000):     stripe listen --forward-to http://127.0.0.1:8000/stripe/webhook
# Copia el signing secret que imprime Stripe CLI a STRIPE_WEBHOOK_SECRET (whsec_...).

# Versiones de documentos legales (guardadas en users al registrarse). Actualizar al publicar cambios.
LEGAL_TERMS_VERSION=2026-05-19
LEGAL_PRIVACY_VERSION=2026-05-19

VITE_APP_NAME="${APP_NAME}"
VITE_LEGAL_ENTITY_NAME=
VITE_LEGAL_ENTITY_NIF=
VITE_LEGAL_ENTITY_ADDRESS=
VITE_LEGAL_TERMS_VERSION="${LEGAL_TERMS_VERSION}"
VITE_LEGAL_PRIVACY_VERSION="${LEGAL_PRIVACY_VERSION}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

PRO_AUDIT_ALERT_EMAIL=
PRO_AUDIT_PENDING_STALE_DAYS=7
PRO_AUDIT_EMAIL_MAX_DISPLAYED=200
